# Keep LF line endings for files that run on Linux (Debian/Podman), even when checked out on Windows.
* text=auto
*.sh text eol=lf
Dockerfile text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.mako text eol=lf
*.ini text eol=lf
.env.example text eol=lf
.dockerignore text eol=lf
*.ps1 text eol=crlf
