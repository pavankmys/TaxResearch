# Copy this file to .env and change every 'change-me' value
# This file contains defaults for the POC profile only.

# Database (PostgreSQL)
POSTGRES_USER=taxresearch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=taxresearch
DATABASE_URL=postgresql://taxresearch:change-me@localhost:5432/taxresearch

# Object storage (MinIO / S3 API)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=taxresearch
OBJECT_STORE=s3

# Alternative: local filesystem storage
# OBJECT_STORE=local
# LOCAL_STORE_PATH=./data/objects

# Ingestion
# Watch folder as seen inside the worker container. The host folder for the bind mount is
# infra/watch (see infra/compose.yaml). Layout: <watch>/<source_code>/<doc_type>/<file>.
WATCH_FOLDER=/watch

# API and Web
API_PORT=8000
WEB_PORT=3000
CORS_ORIGINS=http://localhost:3000

# Auth (POC: local email + password)
# JWT_SECRET must be at least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-this-is-a-test-secret-min-32-chars-long
JWT_TTL_MINUTES=480

# Logging
LOG_LEVEL=INFO
